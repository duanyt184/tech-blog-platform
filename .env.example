# Local development example, shared by Docker Compose, dev.sh and dev.ps1.
# Copy this file to .env before changing values. Do not commit .env.
#
# DB_PORT: Docker Compose maps MySQL to 3307; a local MySQL service usually listens on 3306.
# dev.sh and dev.ps1 read this file and exports the DB_* values to Spring Boot.
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=tech_blog
DB_USER=tech_blog
DB_PASSWORD=tech_blog_dev_password
DB_PORT=3307

# Spring Boot (set these in the shell that starts the backend when customized)
DB_HOST=localhost
SERVER_PORT=8080
FRONTEND_PORT=5173
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
