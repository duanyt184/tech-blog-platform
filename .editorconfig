# 团队统一的基础编码风格，VSCode / IDEA 都会自动读取
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml,yml,yaml}]
indent_size = 4

[*.{js,ts,vue,json,css,html,md}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
