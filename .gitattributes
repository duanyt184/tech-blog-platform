# 统一换行符，避免 Windows 与 macOS/Linux 协作者互相把文件改成 CRLF
* text=auto

# shell 脚本必须保持 LF，否则 macOS / Linux 上执行会报 ^M 错误
mvnw text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做换行符转换
*.docx binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
